<html>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>NY Street Photography Enthusiasts</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <header class="site-header">
    <a class="title" href="/">NY STREET PHOTOGRAPHY ENTHUSIASTS 🗽</a>
    <a class="add-button" href="/newImage" aria-label="Add a photo">+</a>
  </header>

  <main class="film-wall">
    {% for post in messagesArrayFromServer %}
      <article class="film-frame">
        <img src="{{ post.imgSrc }}" alt="Street photograph">

        <div class="post-info">
          <p>{{ post.date }}{% if post.location %} · {{ post.location }}{% endif %}</p>
          <p>{{ post.description }}</p>
        </div>
      </article>
    {% else %}
      <p class="empty-message">No photos yet. Click + to add one.</p>
    {% endfor %}
  </main>

  <footer class="site-footer">
    “Different eyes, different stories, one shared world.”
  </footer>
</body>
</html>